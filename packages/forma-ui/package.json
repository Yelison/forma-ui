{
  "name": "@yelison/forma-ui",
  "version": "0.0.0",
  "description": "Forma UI: accessible React components and design tokens extracted from Resolve.",
  "keywords": [
    "react",
    "design-system",
    "components",
    "accessibility",
    "a11y",
    "design-tokens",
    "css-custom-properties",
    "dark-mode",
    "typescript"
  ],
  "homepage": "https://yelison.github.io/forma-ui/",
  "bugs": {
    "url": "https://github.com/Yelison/forma-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yelison/forma-ui.git",
    "directory": "packages/forma-ui"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/css-modules.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./base.css": "./dist/base.css",
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:tokens": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-tokens.ts",
    "build:icons": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-icons.ts",
    "build": "npm run clean && npm run build:tokens && npm run build:icons && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "check:consumer": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-consumer.ts",
    "pack:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/pack-check.ts",
    "test": "vitest run --maxWorkers=3",
    "test:coverage": "vitest run --maxWorkers=3 --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts --maxWorkers=3"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "~4.13.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "publint": "^0.3.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
