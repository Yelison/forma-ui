    "48": {
      "$type": "dimension",
      "$value": "48px"
    },
    "64": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "panel": {
      "$type": "dimension",
      "$value": "12px"
    },
    "control": {
      "$type": "dimension",
      "$value": "8px"
    },
    "small": {
      "$type": "dimension",
      "$value": "4px"
    },
    "round": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "Falls back to touch.target below 768px.",
      "$extensions": {
        "forma": {
          "media": {
            "(max-width: 767.98px)": "{touch.target}"
          }
        }
      }
    },
    "icon-size": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Width and height of the icon inside a text control (the chevron of a Select, the magnifier of a SearchField); the control reserves room for it with the same value."
    }
  },
  "button": {
    "height": {
      "$type": "dimension",
      "$value": "42px",
      "$description": "Falls back to touch.target below 768px.",
      "$extensions": {
        "forma": {
          "media": {
            "(max-width: 767.98px)": "{touch.target}"
          }
        }
      }
    },
    "height-compact": {
      "$type": "dimension",
      "$value": "36px",
      "$description": "The height of a compact Button. Below 768px it is touch.target, as button.height is: a compact button is as big as a default one on a small screen, so that the touch target is never smaller than the package's minimum.",
      "$extensions": {
        "forma": {
          "media": {
            "(max-width: 767.98px)": "{touch.target}"
          }
        }
      }
    }
  },
  "touch": {
    "target": {
      "$type": "dimension",
      "$value": "44px"
    }
  },
  "avatar": {
    "size-small": {
      "$type": "dimension",
      "$value": "28px",
      "$description": "The small Avatar; Resolve's value."
    },
    "size-medium": {
      "$type": "dimension",
      "$value": "36px",
      "$description": "The default Avatar; Resolve's value."
    },
    "size-large": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "The large Avatar; Resolve's value."
    }
  },
  "badge": {
    "min-height": {
      "$type": "dimension",
      "$value": "28px"
    }
  },
  "choice": {
    "min-height": {
      "$type": "dimension",
      "$value": "36px",
      "$description": "The row of a Radio; Resolve's value, which no other token holds."
    }
  },
  "icon-button": {
    "glyph-size": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Width and height of each icon of an IconButton; the overlap of a double arrow follows it."
    }
  },
  "spinner": {
    "size": {
      "$type": "dimension",
      "$value": "16px"
    }
  },
  "tabs": {
    "panel-focus-offset": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Gap between a focused tab panel and its focus ring; the tabs themselves use 2px."
    }
  },
  "dialog-enter": {
    "offset": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "How far below its place a dialog starts when it enters."
    }
  },
  "tooltip": {
    "max-width": {
      "$type": "dimension",
      "$value": "240px"
    }
  },
  "dialog": {
    "width": {
      "$type": "dimension",
      "$value": "440px"
    },
    "width-wide": {
      "$type": "dimension",
      "$value": "640px"
    }
  }
}
