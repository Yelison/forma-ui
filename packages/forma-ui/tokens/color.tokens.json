        "forma": {
          "modes": {
            "light": "#111e35",
            "dark": "#0a101c"
          }
        }
      }
    },
    "nav-active": {
      "$type": "color",
      "$value": "#263b5d",
      "$extensions": {
        "forma": {
          "modes": {
            "light": "#263b5d",
            "dark": "#233652"
          }
        }
      }
    },
    "nav-text": {
      "$type": "color",
      "$value": "#a8b7d0",
      "$extensions": {
        "forma": {
          "modes": {
            "light": "#a8b7d0",
            "dark": "#a8b7d0"
          }
        }
      }
    },
    "brand": {
      "$type": "color",
      "$value": "#3569f6",
