{
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#f5f7fb",
      "$extensions": {
        "forma": {
          "modes": {
            "light": "#f5f7fb",
            "dark": "#0b1220"
          }
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "forma": {
          "modes": {
            "light": "#ffffff",
            "dark": "#141f32"
          }
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#17243d",
      "$extensions": {
        "forma": {
          "modes": {
            "light": "#17243d",
            "dark": "#e7edf8"
          }
        }
      }
    },
    "muted": {
      "$type": "color",
      "$value": "#616d81",
      "$description": "Adjusted to AA in code (Resolve #14); not in Figma. The contrast test guards it.",
      "$extensions": {
        "forma": {
          "modes": {
            "light": "#616d81",
            "dark": "#a0afc5"
          }
        }
      }
    },
    "line": {
      "$type": "color",
      "$value": "#e4e9f1",
      "$extensions": {
        "forma": {
          "modes": {
            "light": "#e4e9f1",
            "dark": "#2a3951"
          }
        }
      }
    },
    "nav": {
      "$type": "color",
      "$value": "#111e35",
