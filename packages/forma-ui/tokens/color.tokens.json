        "forma": {
          "modes": {
            "light": "#3161e0",
            "dark": "#2a5ee6"
          }
        }
      }
    },
    "link": {
      "$type": "color",
      "$value": "{color.blue-ink}",
      "$description": "Brand text: semantic token from code (Resolve #65); not in Figma.",
      "$extensions": {
        "forma": {
          "modes": {
            "light": "{color.blue-ink}",
            "dark": "{color.blue-ink}"
