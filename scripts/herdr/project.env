# Project settings for the Herdr task scripts (docs/development/herdr.md). Sourced by common.sh.
# Every value can be overridden by an environment variable of the same name; an empty value overrides too
# (HERDR_PR_ASSIGNEE= opens pull requests without an assignee). Keep this file free of secrets and machine paths.

# Id of the project: prefix of workspace labels and of the Compose project, when Compose is on.
HERDR_PROJECT_ID=${HERDR_PROJECT_ID-forma-ui}

# Where worktrees/, tasks/ and logs/ live. Must be absolute and outside the repository.
HERDR_TASKS_ROOT=${HERDR_TASKS_ROOT-$HOME/forma-ui-herdr}

# Port slots: a task gets one slot and its ports are base + slot.
HERDR_SLOT_MIN=${HERDR_SLOT_MIN-1}
HERDR_SLOT_MAX=${HERDR_SLOT_MAX-9}

# Ports of a slot, as whitespace-separated NAME:BASE:MARKER entries. NAME is the variable written to .env.herdr,
# BASE the port of slot 0 and MARKER the __MARKER__ that fill-brief.sh replaces with the slot's port.
HERDR_PORTS=${HERDR_PORTS-DEV_SERVER_PORT:5280:VITE PLAYWRIGHT_PORT:4280:PW STORYBOOK_PORT:6080:SB}

# Checks ship.sh waits for before it merges, comma-separated and matched by exact name. Empty: it waits for none and
# merges at once (a repository without CI, or without required checks, cannot use auto-merge).
HERDR_REQUIRED_CHECKS=${HERDR_REQUIRED_CHECKS-Library,Site,Site e2e}

# Assignee of the pull requests ship.sh opens. Empty: no assignee.
HERDR_PR_ASSIGNEE=${HERDR_PR_ASSIGNEE-Yelison}

# Model of the reviewers new-review.sh starts (passed as --model, next to --advisor none). Empty: the owner's default.
HERDR_REVIEW_MODEL=${HERDR_REVIEW_MODEL-claude-opus-5-5}

# What `new-task.sh --install` runs: the command, in this directory of the worktree (relative to its root). It is
# skipped, with a note, when the directory has no package.json.
HERDR_INSTALL_DIR=${HERDR_INSTALL_DIR-.}
HERDR_INSTALL_CMD=${HERDR_INSTALL_CMD-npm ci}

# Docker Compose per task: 1 gives each task a Compose project (COMPOSE_PROJECT_NAME in .env.herdr, leftover checks
# and `down` in remove-task.sh); 0 never calls docker.
HERDR_COMPOSE=${HERDR_COMPOSE-0}
HERDR_COMPOSE_FILE=${HERDR_COMPOSE_FILE-docker-compose.yml}
