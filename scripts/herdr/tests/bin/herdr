#!/usr/bin/env bash
# Stateful fake of the herdr CLI for testing scripts/herdr (never the real one).
set -euo pipefail
S=${FAKE_STATE:?}; mkdir -p "$S/ws" "$S/agents"
cmd="$1 ${2:-}"; shift 2 || true
opt() { local k=$1; shift; while [ $# -gt 0 ]; do [ "$1" = "$k" ] && { printf '%s' "$2"; return; }; shift; done; }
case $cmd in
  "worktree create")
    repo=$(opt --cwd "$@"); br=$(opt --branch "$@"); base=$(opt --base "$@"); path=$(opt --path "$@")
    n=$(( $(ls "$S/ws" | wc -l) + 1 + $(cat "$S/counter" 2>/dev/null || echo 0) )); echo "$n" >"$S/counter"
    git -C "$repo" worktree add -q -b "$br" "$path" "$base" >&2
    jq -n --arg p "$path" --arg r "$repo" --arg b "$br" --arg pane "p$n" --arg l "$(opt --label "$@")" '{path:$p,repo:$r,branch:$b,pane:$pane,label:$l}' >"$S/ws/w$n"
    jq -n --arg w "w$n" --arg t "t$n" --arg p "p$n" '{result:{workspace:{workspace_id:$w},tab:{tab_id:$t},root_pane:{pane_id:$p}}}' ;;
  "worktree remove")
    ws=$(opt --workspace "$@"); f="$S/ws/$ws"; [ -f "$f" ] || { echo "no workspace" >&2; exit 1; }
    git -C "$(jq -r .repo "$f")" worktree remove "$(jq -r .path "$f")" >&2; rm -f "$f"; echo '{}' ;;
  "workspace get") [ -f "$S/ws/$1" ] || exit 1; echo '{}' ;;
  "pane get") for f in "$S"/ws/*; do [ -f "$f" ] && [ "$(jq -r .pane "$f")" = "$1" ] && { echo '{}'; exit 0; }; done; exit 1 ;;
  "agent list") if ls "$S"/agents/* >/dev/null 2>&1; then jq -s '{result:{agents:.}}' "$S"/agents/*; else echo '{"result":{"agents":[]}}'; fi ;;
  "agent get") f="$S/agents/$1"; [ -f "$f" ] || exit 1; jq '{result:{agent:.}}' "$f" ;;
  "agent start") name=$1; shift; pane=$(opt --pane "$@")
    jq -n --arg n "$name" --arg p "$pane" --arg st "${FAKE_AGENT_STATE:-idle}" '{name:$n,pane_id:$p,agent:"claude",agent_status:$st}' >"$S/agents/$name"
    echo "start $name $*" >>"$S/calls.log"; echo '{}' ;;
  "agent read") f="$S/agents/$1"; [ -f "$f" ] || exit 1
    pane=$(jq -r .pane_id "$f")
    for w in "$S"/ws/*; do [ "$(jq -r .pane "$w")" = "$pane" ] && wt=$(jq -r .path "$w"); done
    lvl=$(jq -r '.modelSettings["claude-sonnet-5-5"].effortLevel // "medium"' "$wt/.claude/settings.local.json" 2>/dev/null || echo medium)
    mdl=$(jq -r '.model // "claude-sonnet-5-5"' "$wt/.claude/settings.local.json" 2>/dev/null || echo claude-sonnet-5-5)
    name=$(sed -E 's/^claude-//; s/-([0-9]+)-([0-9]+)(-[0-9]+)?$/ \1.\2/' <<<"$mdl")
    shown=${FAKE_AGENT_MODEL:-${name^}}
    # FAKE_AGENT_SCREEN: what the session draws. A fresh one has the header, a resumed one (--continue) has none.
    case ${FAKE_AGENT_SCREEN:-header} in
      header) echo "$shown with $lvl effort" ;;
      statusbar) printf 'resumed conversation\n%s  ⎇ feat/x\n' "$shown" ;;
      thinking) printf '✻ thinking with %s effort\n%s  ⎇ feat/x\n' "$lvl" "$shown" ;;
      none) echo "resumed conversation" ;;
      # The conversation quotes the spinner's phrase; the real bar has no spinner line.
      quoted) printf '● the spinner says thinking with high effort\n  printf "✻ thinking with high effort"\n\n  %s  ⎇ feat/x  │ usage —\n' "$shown" ;;
      quoted-capital) printf '✻ Thinking with high effort\n\n  %s  ⎇ feat/x\n' "$shown" ;;
      # The pane still holds the header of the session before a restart (set-effort.sh), above a spinner at the new level.
      stale) echo "▝▜██████▀  $shown with low effort · Claude Team"; seq 1 20 | sed 's/^/● line /'
        printf '· Sock-hopping… (5s · ↓ 381 tokens · thinking with %s effort)\n  %s  ⎇ feat/x\n' "$lvl" "$shown" ;;
      # Lines copied from a real session. A new one has the header far above the last twelve lines and no spinner.
      real-new) echo "▝▜██████▀  $shown with $lvl effort · Claude Team"; seq 1 20 | sed 's/^/● line /'
        printf '  %s  ⎇ feat/x  │ ctx 58k  │ usage 17%% · ↻ 2h51m | 88%% · ↻ 2d10h\n' "$shown" ;;
      real-working) printf '✶ Crystallizing… (25s · ↓ 496 tokens · still thinking with %s effort)\n  %s  ⎇ feat/x  │ ctx 58k\n' "$lvl" "$shown" ;;
    esac ;;
  "agent prompt") name=$1; printf '%s\t%s\n' "$name" "$2" >>"$S/prompts.log"; [ "$2" = "/exit" ] && { rm -f "$S/agents/$name"; echo "exit $name" >>"$S/events.log"; }; echo '{}' ;;
  "agent wait") exit 0 ;;
  "agent send-keys") exit 0 ;;
  *) echo "fake herdr: unsupported $cmd $*" >&2; exit 2 ;;
esac
