# Example of the .env.herdr that scripts/herdr/new-task.sh writes at the root of each task worktree (slot 1, with the
# ports of project.env). The file is ignored by git (.env.*). Load it in a shell with: set -a; . ./.env.herdr; set +a
HERDR_TASK_ID=h1-button-docs
HERDR_TASK_SLOT=1
HERDR_TASK_BRANCH=feat/button-docs
HERDR_TASK_WORKTREE=/path/to/forma-ui-herdr/worktrees/h1-button-docs
HERDR_TASK_LOG_DIR=/path/to/forma-ui-herdr/logs/h1-button-docs
DEV_SERVER_PORT=5281      # the site's dev server (Vite)
PLAYWRIGHT_PORT=4281      # the preview server Playwright starts
STORYBOOK_PORT=6081       # Storybook
# With HERDR_COMPOSE=1 the file also carries COMPOSE_PROJECT_NAME=forma-ui-h1-button-docs; without it, nothing else.
